# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical deployment URL for SEO, sitemap.xml, and OpenGraph tags.
APP_URL="https://www.jpdroofing.co.uk"

# ENQUIRY_WEBHOOK_URL: Optional webhook URL (e.g., Formspree, Web3Forms, Zapier, Make, or custom SMTP bridge)
# to forward incoming quote requests and callback enquiries in production.
ENQUIRY_WEBHOOK_URL=""

# OWNER_NOTIFICATION_EMAIL: Optional destination email for quote notifications (e.g. jpdroofingltd@outlook.com)
OWNER_NOTIFICATION_EMAIL="jpdroofingltd@outlook.com"
